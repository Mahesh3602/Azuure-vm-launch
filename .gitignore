# Local terraform directory (contains providers and modules)
.terraform/

# Terraform state files (These are stored in Azure, but local copies can appear during testing)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variables files (where passwords might be stored locally)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Temporary plan files
*.tfplan